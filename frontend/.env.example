# Copy to frontend/.env.local for local development. NEVER commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; all others stay on the server.

# --- Public (browser) -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Server only (secrets) --------------------------------------------------
# development | test | staging | production
APP_ENV=development
# Bypasses Row Level Security. Server code only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments: only the MOCK provider exists until the owner approves a real
# UAE gateway. The app refuses to start in production with the mock provider.
PAYMENT_PROVIDER=mock
# At least 16 characters. Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Email: "log" records confirmation emails instead of sending them until a
# provider is approved.
EMAIL_PROVIDER=log
EMAIL_FROM=Umodai <no-reply@example.com>
